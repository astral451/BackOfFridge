# Shared secret required in the x-api-key header for all /api requests,
# and entered once in the web UI (stored in the browser's localStorage).
API_KEY=change-me-to-something-long-and-random

PORT=3000

# Optional: only needed if you're using a Cloudflare Named Tunnel (see
# README's "Cloudflare Tunnel" section) rather than the free Quick Tunnel.
# Leave both blank/unset to skip the tunnel entirely - `docker compose up`
# then only starts the app itself.
# TUNNEL_TOKEN=the-token-from-the-cloudflare-dashboard
# COMPOSE_PROFILES=tunnel
